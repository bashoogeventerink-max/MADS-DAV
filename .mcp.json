{
  "mcpServers": {
    "goad": {
      "command": "sh",
      "args": [
        "-c",
        "uv run --no-project https://raw.githubusercontent.com/raoulg/goad_toolkit/$GOAD_REF/goad_mcp.py"
      ],
      "env": {
        "GOAD_REF": "stable"
      }
    },
    "codestyle": {
      "command": "sh",
      "args": [
        "-c",
        "uv run --no-project https://raw.githubusercontent.com/raoulg/codestyle/$CODESTYLE_REF/codestyle_mcp.py"
      ],
      "env": {
        "CODESTYLE_REF": "stable"
      }
    },
    "learn": {
      "command": "npx",
      "args": [
        "-y",
        "https://learn.pttrn.io/mcp/learn-student-mcp.tgz"
      ],
      "env": {
        "LEARN_TOKEN": "${LEARN_TOKEN}",
        "LEARN_PROJECT_ID": "learn-79720",
        "LEARN_API_KEY": "${LEARN_API_KEY}"
      }
    }
  }
}
